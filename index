.ann::after{content:'';position:absolute;top:0;left:-100%;width:55%;height:100%;background:linear-gradient(90deg,transparent,rgba(255,255,255,.38),transparent);animation:sweep 3.5s infinite}
@keyframes sweep{to{left:140%}}

/* TOP BAR */
.topbar{background:var(--bg2);border-bottom:1px solid var(--border);padding:.6rem 2rem;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:.6rem;font-size:.8rem;transition:var(--t)}
.tb-l{display:flex;gap:1.5rem;align-items:center;flex-wrap:wrap}
.tbi{display:flex;align-items:center;gap:.4rem;color:var(--muted)}
