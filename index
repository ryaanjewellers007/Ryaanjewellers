.search-box input{width:100%;padding:1.2rem 3.5rem 1.2rem 1.5rem;background:var(--bg2);border:2px solid var(--gold);color:var(--txt);font-family:var(--body);font-size:1.1rem;border-radius:4px}
.search-box input:focus{outline:none}
