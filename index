/* SEARCH BAR */
.search-overlay{position:fixed;inset:0;background:rgba(23,18,26,.92);z-index:9998;display:none;align-items:flex-start;justify-content:center;padding-top:8rem;backdrop-filter:blur(8px)}
.search-overlay.open{display:flex}
