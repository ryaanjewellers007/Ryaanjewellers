.logo-sub{font-size:.58rem;letter-spacing:2.5px;color:var(--muted);text-transform:uppercase;margin-top:-4px}
.nav-ul{display:flex;gap:1.7rem;list-style:none}
.nav-ul a{font-size:.78rem;font-weight:500;letter-spacing:1.5px;text-transform:uppercase;color:var(--txt2);text-decoration:none;position:relative;padding:.4rem 0;transition:var(--t)}
.nav-ul a::after{content:'';position:absolute;bottom:0;left:0;width:0;height:1.5px;background:var(--gold);transition:width .38s}
