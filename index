/* HERO */
.hero{position:relative;height:100vh;min-height:580px;display:flex;align-items:center;justify-content:center;overflow:hidden;background:#0A070C}
.hero-bg{position:absolute;inset:0;background:url('https://raw.githubusercontent.com/ryaanjewellers007/Ryaanjewellers/main/Messika%20rose%20uno%20move.jpg') center/cover;opacity:.3;animation:zbg 22s ease-in-out infinite alternate;filter:blur(2px)}
@keyframes zbg{0%{transform:scale(1)}100%{transform:scale(1.14)}}
.hero-ov{position:absolute;inset:0;background:radial-gradient(ellipse at 50% 60%,rgba(10,7,12,.05) 0%,rgba(10,7,12,.92) 100%)}
