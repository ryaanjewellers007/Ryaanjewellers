.soc{width:27px;height:27px;border:1px solid var(--gold);border-radius:50%;display:flex;align-items:center;justify-content:center;color:var(--gold);text-decoration:none;font-size:.76rem;transition:var(--t)}
.soc:hover{background:var(--gold);color:#17121A;transform:translateY(-3px) rotate(360deg);box-shadow:var(--glow)}
.small-btn{background:var(--card);border:1px solid var(--border);color:var(--txt);padding:.35rem .85rem;border-radius:20px;cursor:pointer;font-size:.76rem;font-family:var(--body);display:flex;align-items:center;gap:.4rem;transition:var(--t)}
.small-btn:hover{background:var(--gold);color:#17121A}
.gold-ticker{background:var(--gold-d);color:var(--gold-h);padding:.35rem 1rem;border-radius:20px;font-size:.74rem;font-weight:600;letter-spacing:.5px;display:flex;align-items:center;gap:.4rem}

/* ANIMATED LOGO */
@keyframes logoFloat{0%,100%{transform:translateY(0) scale(1)}50%{transform:translateY(-7px) scale(1.04)}}
@keyframes logoGlow{0%,100%{filter:drop-shadow(0 0 6px rgba(183,110,121,.5)) drop-shadow(0 0 14px rgba(183,110,121,.28))}50%{filter:drop-shadow(0 0 22px rgba(183,110,121,.95)) drop-shadow(0 0 42px rgba(183,110,121,.55))}}
@keyframes logoEntry{from{transform:rotate(-15deg) scale(.65);opacity:0}to{transform:rotate(0) scale(1);opacity:1}}
@keyframes logoRotatePulse{0%,100%{transform:scale(1)}50%{transform:scale(1.08) rotate(3deg)}}
.logo-img{width:62px;height:62px;border-radius:50%;border:2.5px solid var(--gold);object-fit:cover;animation:logoEntry .9s cubic-bezier(.16,1,.3,1) forwards,logoFloat 4s ease-in-out 1s infinite,logoGlow 3.2s ease-in-out 1s infinite;cursor:pointer;transition:var(--t)}
.logo-img:hover{transform:scale(1.18) rotate(8deg)!important;box-shadow:var(--glow)}
@keyframes goldShimmer{0%{background-position:0%}100%{background-position:300%}}

/* NAV */
.nav{position:sticky;top:0;z-index:999;background:var(--bg2);border-bottom:2px solid var(--gold);box-shadow:0 4px 22px rgba(183,110,121,.13);transition:var(--t)}
.nav-in{max-width:1520px;margin:0 auto;padding:1rem 2rem;display:flex;justify-content:space-between;align-items:center}
.logo-wrap{display:flex;align-items:center;gap:.8rem;text-decoration:none}
