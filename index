@keyframes rise{from{opacity:0;transform:translateY(55px)}to{opacity:1;transform:translateY(0)}}
.hero-badge{display:inline-flex;align-items:center;gap:.7rem;padding:.58rem 1.9rem;background:rgba(183,110,121,.12);border:1.5px solid var(--gold);border-radius:50px;font-size:.7rem;font-weight:600;letter-spacing:3.5px;text-transform:uppercase;color:var(--gold);margin-bottom:1.8rem}
.hero-title{font-family:var(--serif);font-size:clamp(2.8rem,9vw,7rem);font-weight:700;font-style:italic;color:#FBF7F6;line-height:1.05;margin-bottom:1.2rem;text-shadow:0 18px 45px rgba(0,0,0,.75)}
.hero-sub{font-family:var(--italic);font-size:clamp(1rem,2.5vw,1.65rem);font-style:italic;color:#EBDDE0;margin-bottom:2.5rem;letter-spacing:1.5px;font-weight:300}
.pills{display:flex;justify-content:center;gap:.85rem;flex-wrap:wrap;margin:2rem 0}
