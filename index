.btn{padding:.92rem 2.3rem;font-family:var(--body);font-size:.79rem;font-weight:600;letter-spacing:2px;text-transform:uppercase;text-decoration:none;border:none;cursor:pointer;transition:var(--ts);display:inline-flex;align-items:center;gap:.6rem;position:relative;overflow:hidden;border-radius:2px}
