.pfall{display:none;position:absolute;inset:0;background:var(--gold-p);align-items:center;justify-content:center;flex-direction:column;gap:.75rem;z-index:1}
.pinfo{padding:1.3rem}
.pbrand{font-size:.62rem;font-weight:600;letter-spacing:2px;text-transform:uppercase;color:var(--gold);margin-bottom:.3rem}
.pname{font-family:var(--serif);font-size:1.02rem;font-weight:600;color:var(--txt);margin-bottom:.42rem;line-height:1.3}
.pdesc{font-size:.78rem;color:var(--muted);margin-bottom:.85rem;line-height:1.6}
.pfooter{display:flex;align-items:center;justify-content:space-between;gap:.5rem}
.pprice{font-size:1.15rem;font-weight:700;color:var(--txt)}
.pprice span{font-size:.65rem;color:var(--muted);font-weight:400}
.pcart{background:var(--gold);border:none;color:#17121A;padding:.42rem .95rem;font-size:.7rem;font-weight:600;letter-spacing:1px;cursor:pointer;border-radius:3px;transition:var(--t);font-family:var(--body);white-space:nowrap}
.pcart:hover{background:var(--gold-h);transform:scale(1.06)}
.pcart.added{background:#2A6846;color:#fff}

/* GOLD SERVICES */
.gold-sec{background:linear-gradient(135deg,var(--gold-d),var(--gold),#C98189,var(--gold));position:relative;overflow:hidden}
.gold-sec::before{content:'';position:absolute;inset:0;background:url("data:image/svg+xml,%3Csvg width='70' height='70' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M35 0L70 35L35 70L0 35Z' fill='none' stroke='rgba(255,255,255,0.07)' stroke-width='1'/%3E%3C/svg%3E") repeat;opacity:.6}
.gs-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(290px,1fr));gap:2.5rem}
.gs-card{background:rgba(255,255,255,.93);padding:2.4rem;border-radius:10px;text-align:center;transition:var(--ts);box-shadow:0 8px 28px rgba(0,0,0,.14)}
.gs-card:hover{transform:translateY(-13px);box-shadow:0 28px 65px rgba(0,0,0,.24)}
.gs-ico{width:82px;height:82px;margin:0 auto 1.7rem;background:linear-gradient(135deg,var(--gold-d),var(--gold));border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:2.3rem;color:#17121A;box-shadow:0 8px 24px rgba(183,110,121,.45)}
.gs-title{font-family:var(--serif);font-size:1.6rem;font-weight:700;color:#17121A;margin-bottom:.75rem}
.gs-desc{font-size:.9rem;color:#3A2E3E;line-height:1.85;margin-bottom:1.4rem}
.gs-list{list-style:none;text-align:left;margin-bottom:1.9rem}
.gs-list li{display:flex;align-items:center;gap:.75rem;padding:.55rem 0;border-bottom:1px solid rgba(183,110,121,.2);font-size:.87rem;color:#3A2E3E}
.gs-list li:last-child{border:none}
.gs-list i{color:var(--gold)}

/* TRYON */
.tryon-grid{display:grid;grid-template-columns:1fr 1fr;gap:5rem;align-items:center}
.tryon-box{aspect-ratio:4/5;background:var(--card);border-radius:10px;overflow:hidden;border:2px solid var(--gold);box-shadow:var(--shad);display:flex;align-items:center;justify-content:center;flex-direction:column;gap:1.5rem;padding:2.5rem;text-align:center;position:relative}
#tryonCanvas{display:none;position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
#tryonVideo{display:none;position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
.tryon-feats{list-style:none;margin:2rem 0}
.tryon-feats li{display:flex;align-items:flex-start;gap:.9rem;padding:.85rem 0;border-bottom:1px solid var(--border)}
.tryon-feats li:last-child{border:none}
.tryon-feats i{color:var(--gold);font-size:1.05rem;margin-top:.2rem}

/* CART SIDEBAR */
.cart-sidebar{position:fixed;top:0;right:-420px;width:420px;height:100vh;background:var(--bg2);z-index:9997;box-shadow:-10px 0 40px rgba(0,0,0,.15);transition:right .4s cubic-bezier(.4,0,.2,1);display:flex;flex-direction:column;border-left:2px solid var(--gold)}
.cart-sidebar.open{right:0}
.cart-header{padding:1.8rem;border-bottom:1px solid var(--border);display:flex;justify-content:space-between;align-items:center}
.cart-header h3{font-family:var(--serif);font-size:1.5rem;color:var(--txt)}
.close-btn{background:none;border:none;font-size:1.4rem;color:var(--muted);cursor:pointer;transition:var(--t)}
.close-btn:hover{color:var(--gold);transform:rotate(90deg)}
.cart-items{flex:1;overflow-y:auto;padding:1.5rem}
.cart-empty{text-align:center;padding:3rem;color:var(--muted)}
.cart-empty i{font-size:3rem;color:var(--border);margin-bottom:1rem;display:block}
.cart-item{display:flex;gap:1rem;padding:1rem 0;border-bottom:1px solid var(--border);align-items:center}
.ci-img{width:68px;height:68px;object-fit:cover;border-radius:4px;border:1px solid var(--border);flex-shrink:0}
.ci-info{flex:1}
.ci-name{font-size:.88rem;font-weight:600;color:var(--txt);margin-bottom:.3rem}
.ci-price{font-size:.95rem;font-weight:700;color:var(--gold)}
.ci-qty{display:flex;align-items:center;gap:.5rem;margin-top:.4rem}
.qty-btn{width:24px;height:24px;background:var(--card);border:1px solid var(--border);border-radius:3px;cursor:pointer;font-size:.85rem;display:flex;align-items:center;justify-content:center;transition:var(--t)}
.qty-btn:hover{background:var(--gold);color:#17121A}
.ci-del{background:none;border:none;color:var(--muted);cursor:pointer;font-size:.9rem;padding:.3rem;transition:var(--t)}
.ci-del:hover{color:#B02020}
.cart-footer{padding:1.8rem;border-top:1px solid var(--border)}
.cart-total{display:flex;justify-content:space-between;font-size:1.2rem;font-weight:700;color:var(--txt);margin-bottom:1.5rem}
.cart-total span:last-child{color:var(--gold)}

/* CHECKOUT MODAL */
.modal{position:fixed;inset:0;background:rgba(23,18,26,.88);z-index:9999;display:none;align-items:center;justify-content:center;padding:1.5rem;backdrop-filter:blur(8px)}
.modal.open{display:flex}
.modal-box{background:var(--bg2);border:2px solid var(--gold);border-radius:8px;max-width:600px;width:100%;max-height:90vh;overflow-y:auto;box-shadow:0 25px 80px rgba(0,0,0,.4)}
.modal-head{padding:1.8rem 2rem;border-bottom:1px solid var(--border);display:flex;justify-content:space-between;align-items:center;position:sticky;top:0;background:var(--bg2);z-index:1}
.modal-head h3{font-family:var(--serif);font-size:1.5rem;color:var(--txt)}
.modal-body{padding:2rem}
.form-row{display:grid;grid-template-columns:1fr 1fr;gap:1.2rem;margin-bottom:1.2rem}
.form-group{margin-bottom:1.2rem}
.form-label{display:block;font-size:.7rem;font-weight:600;letter-spacing:2px;text-transform:uppercase;color:var(--muted);margin-bottom:.55rem}
.form-input,.form-select,.form-textarea{width:100%;padding:.95rem;background:var(--card);border:1.5px solid var(--border);color:var(--txt);font-family:var(--body);font-size:.9rem;transition:var(--t);border-radius:3px}
.form-input:focus,.form-select:focus,.form-textarea:focus{outline:none;border-color:var(--gold);box-shadow:0 0 0 3px rgba(183,110,121,.12)}
.form-textarea{resize:vertical;min-height:100px}
.pay-methods{display:grid;grid-template-columns:repeat(3,1fr);gap:.75rem;margin-bottom:1.5rem}
.pay-opt{padding:.75rem;border:1.5px solid var(--border);border-radius:5px;text-align:center;cursor:pointer;transition:var(--t)}
.pay-opt:hover,.pay-opt.selected{border-color:var(--gold);background:var(--gold-p)}
.pay-opt i{font-size:1.5rem;color:var(--gold);display:block;margin-bottom:.4rem}
.pay-opt span{font-size:.75rem;font-weight:600;color:var(--txt)}
.checkout-summary{background:var(--card);border-radius:6px;padding:1.5rem;margin-bottom:1.5rem}
.cs-row{display:flex;justify-content:space-between;padding:.4rem 0;font-size:.88rem;color:var(--txt2)}
.cs-row.total{font-weight:700;font-size:1.05rem;color:var(--txt);border-top:1px solid var(--border);margin-top:.5rem;padding-top:.75rem}
.form-btn{width:100%;padding:1.3rem;background:var(--gold);color:#17121A;font-size:.82rem;font-weight:700;letter-spacing:3px;text-transform:uppercase;border:none;cursor:pointer;transition:var(--ts);font-family:var(--body);border-radius:3px;display:flex;align-items:center;justify-content:center;gap:.7rem}
.form-btn:hover{background:var(--gold-h);transform:translateY(-2px);box-shadow:var(--glow)}
.form-btn:disabled{opacity:.6;cursor:not-allowed;transform:none}

/* ORDER SUCCESS */
.order-success{text-align:center;padding:3rem 2rem}
.order-success .check{width:80px;height:80px;background:var(--gold);border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 2rem;font-size:2rem;color:#17121A;animation:popIn .5s cubic-bezier(.16,1,.3,1)}
@keyframes popIn{from{transform:scale(0)}to{transform:scale(1)}}

/* WISHLIST SIDEBAR */
.wishlist-sidebar{position:fixed;top:0;left:-420px;width:420px;height:100vh;background:var(--bg2);z-index:9997;box-shadow:10px 0 40px rgba(0,0,0,.15);transition:left .4s cubic-bezier(.4,0,.2,1);display:flex;flex-direction:column;border-right:2px solid var(--gold)}
.wishlist-sidebar.open{left:0}

/* PRODUCT MODAL */
.product-modal{position:fixed;inset:0;background:rgba(23,18,26,.9);z-index:9998;display:none;align-items:center;justify-content:center;padding:1.5rem;backdrop-filter:blur(8px)}
.product-modal.open{display:flex}
.pm-box{background:var(--bg2);border:2px solid var(--gold);border-radius:8px;max-width:860px;width:100%;max-height:90vh;overflow-y:auto;box-shadow:0 25px 80px rgba(0,0,0,.4)}
.pm-grid{display:grid;grid-template-columns:1fr 1fr}
.pm-img-side{aspect-ratio:1;overflow:hidden;border-radius:6px 0 0 6px}
.pm-img-side img{width:100%;height:100%;object-fit:cover}
.pm-info-side{padding:2.5rem;display:flex;flex-direction:column;gap:1.2rem}
.pm-brand{font-size:.68rem;font-weight:600;letter-spacing:2.5px;text-transform:uppercase;color:var(--gold)}
.pm-name{font-family:var(--serif);font-size:1.65rem;font-weight:700;color:var(--txt);line-height:1.25}
.pm-price{font-size:1.8rem;font-weight:700;color:var(--txt)}
.pm-desc{font-size:.9rem;color:var(--muted);line-height:1.78}
.pm-specs{background:var(--card);border-left:3px solid var(--gold);padding:1rem 1.2rem;border-radius:0 4px 4px 0}
.pm-spec-row{display:flex;justify-content:space-between;font-size:.85rem;padding:.3rem 0}
.pm-spec-label{color:var(--muted)}
.pm-spec-val{font-weight:600;color:var(--txt)}
.qty-wrap{display:flex;align-items:center;gap:1rem}
.qty-big{display:flex;align-items:center;gap:.6rem}
.qty-big button{width:32px;height:32px;background:var(--card);border:1.5px solid var(--border);border-radius:4px;cursor:pointer;font-size:1rem;color:var(--txt);transition:var(--t)}
.qty-big button:hover{background:var(--gold);color:#17121A;border-color:var(--gold)}
.qty-big span{font-size:1.1rem;font-weight:600;min-width:28px;text-align:center}

/* QR GRID */
.qr-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:2.2rem}
.qr-card{background:var(--card);padding:2.2rem;border-radius:8px;text-align:center;border:2px solid var(--gold);box-shadow:0 4px 18px rgba(183,110,121,.1);transition:var(--ts)}
.qr-card:hover{transform:translateY(-9px);box-shadow:var(--glow)}
.qr-ico{font-size:2.6rem;color:var(--gold);margin-bottom:1.3rem}
.qr-title{font-family:var(--serif);font-size:1.4rem;font-weight:700;color:var(--txt);margin-bottom:.65rem}
.qr-desc{font-size:.85rem;color:var(--muted);margin-bottom:1.6rem;line-height:1.7}
.qr-box{display:inline-block;padding:1.3rem;background:#fff;border:1.5px solid var(--gold);border-radius:6px;margin-bottom:1rem}
.qr-hint{font-size:.72rem;font-weight:600;color:var(--gold);letter-spacing:1px}

/* APPOINTMENT */
.appt-grid{display:grid;grid-template-columns:1fr 1fr;gap:5rem;align-items:start}
.appt-form{background:var(--bg2);padding:3rem;border:2px solid var(--gold);box-shadow:var(--shad);border-radius:6px}
.appt-list{list-style:none;margin-top:2rem}
.appt-list li{display:flex;align-items:center;gap:1rem;padding:.85rem 0;border-bottom:1px solid var(--border);font-size:.93rem;color:var(--txt2)}
.appt-list li:last-child{border:none}
.appt-list i{color:var(--gold);font-size:1.05rem}

/* TESTIMONIALS */
.testi-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:2rem}
.testi-card{background:var(--bg2);border:1.5px solid var(--gold);padding:2.5rem;border-radius:6px;box-shadow:var(--shad)}
.testi-stars{color:var(--gold);margin-bottom:1.2rem}
.testi-q{font-family:var(--italic);font-size:1.1rem;font-style:italic;color:var(--txt);line-height:1.72;margin-bottom:1.5rem}
.testi-avatar{display:flex;align-items:center;gap:.9rem}
.tav{width:42px;height:42px;border-radius:50%;background:var(--gold-p);display:flex;align-items:center;justify-content:center;font-size:1.1rem;color:var(--gold);font-weight:700;font-family:var(--serif)}
.tname{font-weight:600;color:var(--txt);font-size:.92rem}
.tloc{font-size:.78rem;color:var(--muted)}

/* INSTAGRAM */
.ig-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:1.1rem}
.ig-post{aspect-ratio:1;overflow:hidden;position:relative;cursor:pointer;border-radius:5px;background:var(--card)}
.ig-post img{width:100%;height:100%;object-fit:cover;transition:var(--ts)}
.ig-post:hover img{transform:scale(1.16)}
.ig-ov{position:absolute;inset:0;background:rgba(183,110,121,.9);display:flex;align-items:center;justify-content:center;gap:2rem;opacity:0;transition:var(--t);border-radius:5px}
.ig-post:hover .ig-ov{opacity:1}
.ig-stat{display:flex;align-items:center;gap:.4rem;color:#17121A;font-size:1rem;font-weight:700}
.ig-handle{display:inline-flex;align-items:center;gap:.7rem;font-size:1.1rem;color:var(--gold);text-decoration:none;padding:.78rem 1.8rem;border:1.5px solid var(--gold);border-radius:50px;transition:var(--t);margin-bottom:2.5rem}
.ig-handle:hover{background:var(--gold);color:#17121A;transform:scale(1.04)}

/* AI CHATBOT */
.chat-fab{position:fixed;bottom:2rem;right:2rem;width:62px;height:62px;background:var(--gold);border:none;border-radius:50%;cursor:pointer;display:flex;align-items:center;justify-content:center;font-size:1.5rem;color:#17121A;box-shadow:0 8px 30px rgba(183,110,121,.55);transition:var(--t);z-index:9990;animation:chatPulse 3s ease-in-out infinite}
@keyframes chatPulse{0%,100%{box-shadow:0 8px 30px rgba(183,110,121,.55)}50%{box-shadow:0 8px 50px rgba(183,110,121,.85),0 0 0 12px rgba(183,110,121,.1)}}
.chat-fab:hover{transform:scale(1.12) rotate(5deg);background:var(--gold-h)}
.chat-window{position:fixed;bottom:6.5rem;right:2rem;width:380px;height:520px;background:var(--bg2);border:2px solid var(--gold);border-radius:16px;box-shadow:0 20px 60px rgba(0,0,0,.2);display:none;flex-direction:column;z-index:9989;overflow:hidden}
.chat-window.open{display:flex}
.chat-head{background:linear-gradient(135deg,var(--gold-d),var(--gold));padding:1.2rem 1.4rem;display:flex;align-items:center;gap:.9rem;justify-content:space-between}
.chat-head-info{display:flex;align-items:center;gap:.9rem}
.chat-avatar{width:40px;height:40px;border-radius:50%;background:rgba(255,255,255,.2);display:flex;align-items:center;justify-content:center;font-size:1.2rem;border:2px solid rgba(255,255,255,.4)}
.chat-head-txt{color:#17121A}
.chat-head-name{font-weight:700;font-size:.95rem}
.chat-head-status{font-size:.72rem;opacity:.8;display:flex;align-items:center;gap:.3rem}
.chat-status-dot{width:7px;height:7px;background:#2A6846;border-radius:50%;box-shadow:0 0 6px #2A6846}
.chat-close{background:none;border:none;color:#17121A;font-size:1.1rem;cursor:pointer;opacity:.7;transition:var(--t)}
.chat-close:hover{opacity:1;transform:rotate(90deg)}
.chat-messages{flex:1;overflow-y:auto;padding:1.2rem;display:flex;flex-direction:column;gap:.9rem}
.msg{max-width:82%;display:flex;flex-direction:column;gap:.22rem}
.msg.bot{align-self:flex-start}
.msg.user{align-self:flex-end}
.msg-bubble{padding:.75rem 1rem;border-radius:12px;font-size:.86rem;line-height:1.6}
.msg.bot .msg-bubble{background:var(--card);color:var(--txt);border-radius:4px 12px 12px 12px}
.msg.user .msg-bubble{background:var(--gold);color:#17121A;border-radius:12px 4px 12px 12px;font-weight:500}
.msg-time{font-size:.65rem;color:var(--muted)}
.msg.user .msg-time{text-align:right}
.chat-typing{display:flex;align-items:center;gap:.4rem;padding:.75rem 1rem;background:var(--card);border-radius:4px 12px 12px 12px;max-width:80px}
.dot{width:7px;height:7px;border-radius:50%;background:var(--muted);animation:bounce 1.2s infinite}
.dot:nth-child(2){animation-delay:.2s}
.dot:nth-child(3){animation-delay:.4s}
@keyframes bounce{0%,100%{transform:translateY(0)}50%{transform:translateY(-5px)}}
.chat-input-area{padding:1rem;border-top:1px solid var(--border);display:flex;gap:.65rem;align-items:flex-end}
.chat-input{flex:1;padding:.75rem 1rem;background:var(--card);border:1.5px solid var(--border);color:var(--txt);font-family:var(--body);font-size:.88rem;border-radius:20px;resize:none;max-height:90px;outline:none;line-height:1.5;transition:var(--t)}
.chat-input:focus{border-color:var(--gold)}
.chat-send{background:var(--gold);border:none;width:38px;height:38px;border-radius:50%;cursor:pointer;display:flex;align-items:center;justify-content:center;color:#17121A;font-size:.95rem;transition:var(--t);flex-shrink:0}
.chat-send:hover{background:var(--gold-h);transform:scale(1.1)}
.chat-suggestions{display:flex;gap:.5rem;flex-wrap:wrap;padding:.75rem 1.2rem .2rem;border-top:1px solid var(--border)}
.sug-btn{padding:.38rem .85rem;background:var(--gold-p);border:1px solid var(--gold);border-radius:20px;font-size:.73rem;color:var(--gold-d);cursor:pointer;font-family:var(--body);font-weight:500;transition:var(--t)}
.sug-btn:hover{background:var(--gold);color:#17121A}

/* GOLD PRICE TICKER */
.ticker-sec{background:var(--txt);padding:.7rem 0;overflow:hidden}
.ticker-inner{display:flex;gap:4rem;animation:tickerScroll 30s linear infinite;white-space:nowrap}
@keyframes tickerScroll{from{transform:translateX(0)}to{transform:translateX(-50%)}}.ticker-item{display:flex;align-items:center;gap:.6rem;font-size:.78rem;font-weight:600;color:var(--gold-h);letter-spacing:.5px;flex-shrink:0}
.ticker-item i{color:var(--gold)}

/* FOOTER */
.footer{background:var(--bg2);border-top:2.5px solid var(--gold);padding:5rem 2.5rem 2.5rem}
.fg{max-width:1520px;margin:0 auto;display:grid;grid-template-columns:2.2fr 1fr 1fr 1fr;gap:4rem;margin-bottom:4rem}
.f-name{font-family:var(--serif);font-size:2rem;font-weight:700;background:linear-gradient(135deg,var(--gold-d),var(--gold),var(--gold-h));-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;margin-bottom:1.4rem;display:block}
.f-tag{font-size:.88rem;color:var(--muted);line-height:1.87;margin-bottom:2rem}
.f-h4{font-family:var(--serif);font-size:1.18rem;font-style:italic;color:var(--txt);margin-bottom:1.3rem}
.f-ul{list-style:none;display:flex;flex-direction:column;gap:.8rem}
.f-ul a{color:var(--muted);text-decoration:none;font-size:.87rem;transition:var(--t);display:inline-block}
.f-ul a:hover{color:var(--gold);padding-left:6px}
.f-btm{max-width:1520px;margin:0 auto;padding-top:2.2rem;border-top:1px solid var(--border);display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:1rem;font-size:.8rem;color:var(--muted)}
.f-btm a{color:var(--gold);text-decoration:none}

/* TOAST */
.toast{position:fixed;bottom:2rem;left:50%;transform:translateX(-50%) translateY(100px);background:var(--bg2);color:var(--txt);padding:1.1rem 1.8rem;border-left:4px solid var(--gold);box-shadow:var(--shad);z-index:99999;display:flex;align-items:center;gap:.85rem;min-width:260px;max-width:400px;border-radius:5px;transition:transform .4s cubic-bezier(.16,1,.3,1);pointer-events:none}
.toast.show{transform:translateX(-50%) translateY(0)}
.ti{font-size:1.3rem;color:var(--gold)}
.toast.ok{border-color:#2A6846}.toast.ok .ti{color:#2A6846}
.toast.er{border-color:#B02020}.toast.er .ti{color:#B02020}

/* LOADER */
/* LIVE GOLD BADGE */
#goldLive{transition:all .4s;cursor:default}
#goldLive:hover{background:var(--gold)!important;color:#17121A!important}

.loader{position:fixed;inset:0;background:var(--bg);display:flex;align-items:center;justify-content:center;z-index:99999;transition:opacity .55s;flex-direction:column;gap:1.5rem}
.loader.gone{opacity:0;pointer-events:none}
